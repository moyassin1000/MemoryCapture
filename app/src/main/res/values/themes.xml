<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MemoryCapture" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/deep_blue</item>
        <item name="android:navigationBarColor">@color/deep_blue</item>
    </style>

    <style name="Theme.MemoryCapture.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MemoryCapture</item>
    </style>
</resources>
